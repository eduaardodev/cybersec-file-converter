# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT Authentication Secret
JWT_SECRET="academic-secure-conversion-secret-key-2026"

# Database Configuration (sqlite | postgres)
DATABASE_TYPE="sqlite"
DATABASE_URL="postgres://postgres:postgres@localhost:5432/converter_db"

# Storage Directory for uploaded & converted files (private, non-public)
STORAGE_DIR="./storage"

# Concurrency & Worker limits
MAX_CONCURRENT_CONVERSIONS_PER_USER=2
MAX_FILE_SIZE_BYTES=10485760
CONVERSION_TIMEOUT_MS=30000

